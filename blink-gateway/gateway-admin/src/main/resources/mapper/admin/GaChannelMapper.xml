<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blink.gateway.admin.mapper.GaChannelMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.blink.gateway.admin.entity.GaChannelDO">
        <id column="channel_id" property="channelId"/>
        <result column="channel_name" property="channelName"/>
        <result column="app_key" property="appKey"/>
        <result column="app_secret" property="appSecret"/>
        <result column="rela_user_id" property="relaUserId"/>
        <result column="access_token" property="accessToken"/>
        <result column="system_publickey" property="systemPublickey"/>
        <result column="system_privatekey" property="systemPrivatekey"/>
        <result column="channel_publickey" property="channelPublickey"/>
        <result column="channel_privatekey" property="channelPrivatekey"/>
        <result column="enable" property="enable"/>
        <result column="encryption_switch" property="encryptionSwitch"/>
        <result column="token_type" property="tokenType"/>
        <result column="authority_switch" property="authoritySwitch"/>
        <result column="remark" property="remark"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        channel_id, channel_name, app_key, app_secret, rela_user_id, access_token,
        system_publickey, system_privatekey, channel_publickey, channel_privatekey,
        enable, encryption_switch, token_type, authority_switch, remark,
        create_by, update_by, create_time, update_time
    </sql>

    <select id="findAllChannels" resultType="com.blink.gateway.admin.entity.GaChannelDO">
        select
        <include refid="Base_Column_List"/>
        from ga_channel
    </select>

</mapper>
