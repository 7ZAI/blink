<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds" debug="false">

    <!-- ============== 0. 公共变量 ============== -->
    <contextName>gateway-admin</contextName>
    <!-- 统一字符集 -->
    <property name="CHARSET" value="UTF-8"/>
    <!-- 日志根目录，可通过 application.yml 中 logging.file.path 覆盖 -->
    <springProperty scope="context" name="LOG_HOME" source="logging.file.path" defaultValue="./gateway-admin/logs"/>

    <!-- 进程 PID -->
    <springProperty scope="context"
                    name="PID"
                    source="PID"
                    defaultValue="????"/>

    <!-- ============== 1. 通用日志格式 ============== -->
    <!-- 控制台彩色 -->
    <conversionRule conversionWord="clr"
                    converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wEx"
                    converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>

    <!-- dev 环境彩色输出格式 -->
    <springProfile name="dev">
        <property name="CONSOLE_PATTERN"
                  value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${PID}){magenta} %clr(---){faint} %highlight(%-5level) %clr([%15.15t]){faint} %clr(%-40.40logger{32}){cyan} %clr(:){faint} %msg%n%wEx"/>
    </springProfile>

    <!-- 非 dev 环境简洁格式 -->
    <springProfile name="!dev">
        <property name="CONSOLE_PATTERN"
                  value="%d{yyyy-MM-dd HH:mm:ss.SSS} ${PID} --- [%thread] %-5level %logger{36} - %msg%n"/>
    </springProfile>

    <!-- 文件统一格式（含行号） -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} %line - %msg%n"/>

    <!-- ============== 2. 控制台输出 ============== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>${CHARSET}</charset>
        </encoder>
    </appender>

    <!-- ============== 3. 滚动文件输出（默认禁用，生产环境可启用） ============== -->
    <!-- 3.1 INFO 级别文件 -->
