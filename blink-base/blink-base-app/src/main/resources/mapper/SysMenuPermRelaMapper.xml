<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
    <mapper namespace="com.blink.base.mapper.SysMenuPermRelaMapper">

                <!-- 通用查询映射结果 -->
        <resultMap id="BaseResultMap" type="com.blink.base.entity.SysMenuPermRelaDO">
                                                <id column="menu_id" property="menuId"/>
                                                                <id column="ac_id" property="acId"/>
                                                                                                                    </resultMap>
                <!-- 通用查询结果列 -->
        <sql id="Base_Column_List">
            menu_id, ac_id
        </sql>

    
    <!-- 通用查询条件 -->
    <sql id="Condition_where">
        <trim prefix="where" prefixOverrides="and | or ">
            <if test="menuId != null and menuId != ''">and menu_id =
                #{menuId}
            </if>
            <if test="acId != null and acId != ''">and ac_id =
                #{acId}
            </if>
        </trim>
    </sql>


    <select id="findSysMenuPermRelaList" parameterType="com.blink.base.dto.req.QuerySysMenuPermRelaReqDTO"
            resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from sys_menu_perm_rela
        <include refid="Condition_where"/>
    </select>

</mapper>
