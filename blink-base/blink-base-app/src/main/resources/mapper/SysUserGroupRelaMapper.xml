<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blink.base.mapper.SysUserGroupRelaMapper">

    <!-- 根据用户ID查询部门ID -->
    <select id="selectDeptIdByUserId" resultType="java.lang.Integer">
        SELECT group_id
        FROM sys_user_group_rela
        WHERE user_id = #{userId}
        LIMIT 1
    </select>

</mapper>
