    <select id="findSysUserList" parameterType="com.blink.base.dto.req.QuerySysUserReq" resultMap="VoResultMap">
        select user_id,login_name,username,sex,phone,email,last_login_time,sg.group_name,sg.group_id
        from sys_user su
        left join sys_group sg  on  sg.user_id = su.user_id
        <trim prefix="where" prefixOverrides="and | or ">

            <if test="username != null and username != ''">and username = #{username}</if>

            <if test="sex != null ">and sex = #{sex}</if>

            <if test="groupId != null ">and group_id =#{groupId} #{endDate}</if>

            <if test="startDate != null ">and create_time <![CDATA[ >= ]]> #{startDate}</if>

            <if test="endDate != null ">and create_time <![CDATA[ <= ]]> #{endDate}</if>
        </trim>
    </select>

    <select id="findUserDetail" parameterType="com.blink.base.dto.req.QuerySysUserReq" resultMap="VoResultMap">
        select su.user_id,su.login_name,su.username,su.sex,su.phone,su.email,su.last_login_time,
               sg.group_name,sg.group_id,
               sr.role_name,sr.role_id
        from sys_user su
                 left join sys_user_role_rela surr on su.user_id = surr.user_id
                 left join sys_role sr on sr.role_id = surr.role_id
                 left join sys_user_group_rela sugr on su.user_id = sugr.user_id
                 left join sys_group sg  on  sg.group_id = sugr.group_id
        where su.login_name = #{loginName}
    </select>
</mapper>
