{
  "name": "blink-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Blink Frontend Monorepo",
  "keywords": [
    "vue",
    "element-plus",
    "admin",
    "monorepo"
  ],
  "scripts": {
    "dev:components": "pnpm --filter @blink/components dev",
    "dev:base": "pnpm --filter base-admin dev",
    "dev:gateway": "pnpm --filter gateway-admin dev",
    "build:components": "pnpm --filter @blink/components build:lib",
    "build:base": "pnpm --filter base-admin build",
    "build:gateway": "pnpm --filter gateway-admin build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/*.{ts,vue,js,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,vue,js,json,md}\"",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@eslint/js": "^9.22.0",
    "@iconify/vue": "^5.0.0",
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^3.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "element-plus": "^2.13.3",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^10.0.0",
    "happy-dom": "^17.4.7",
    "pinia": "^3.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.5.3",
    "sass": "^1.97.3",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.1",
    "typescript": "~5.9.3",
    "vite": "^6.3.1",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.1.3",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.1.1",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.0",
    "vue-tsc": "^3.1.5"
  }
}