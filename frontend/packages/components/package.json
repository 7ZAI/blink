{
  "name": "@blink/components",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/lib-index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib-index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/components.css": "./dist/components.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:lib": "vite build --config vite.lib.config.ts",
    "pack:lib": "npm run build:lib && npm pack",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": ">=2.3.0",
    "@iconify/vue": ">=5.0.0",
    "element-plus": ">=2.13.0",
    "pinia": ">=3.0.0",
    "vue": ">=3.5.0",
    "vue-i18n": ">=11.0.0",
    "vue-router": ">=4.6.0"
  },
  "dependencies": {
    "axios": "^1.8.2"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@iconify/vue": "^5.0.0",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^3.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "element-plus": "^2.13.3",
    "happy-dom": "^17.4.7",
    "pinia": "^3.0.0",
    "postcss": "^8.5.8",
    "sass": "^1.97.3",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.1",
    "typescript": "~5.9.3",
    "vite": "^6.3.1",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.1.3",
    "vue": "^3.5.0",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.0",
    "vue-tsc": "^3.1.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.59.0"
  }
}
