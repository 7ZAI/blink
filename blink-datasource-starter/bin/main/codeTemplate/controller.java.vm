package ${package.Controller};

import ${package.Service}.${table.serviceName};
import ${reqPackage}.${addReqDTOName};
import ${reqPackage}.${deleteReqDTOName};
import ${reqPackage}.${updateReqDTOName};
import ${reqPackage}.${queryReqDTOName};
import ${rspPackage}.${queryRspDTOName};
import com.blink.framework.common.data.EmptyBody;
import com.blink.framework.common.data.RequestDTO;
import com.blink.framework.common.data.ResponseDTO;
import com.blink.framework.common.exception.BlinkException;
import jakarta.annotation.Resource;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
#set($end=$entity.length() - 2)
#set($entityOrigin=$entity.substring(0,$end))
#set($entityLowerCase=$entityOrigin.substring(0,1).toLowerCase()+$entityOrigin.substring(1))

/**
 *
 *  $!{table.comment} 管理API
 *
 *
 * @module blink
 * @author ${author}
 * @since ${date}
 */
@RestController
@RequestMapping("/${entityLowerCase}")
public class ${table.controllerName} {

        @Resource
        private ${table.serviceName} ${entityLowerCase}Service;


        /**
         * 新增$!{table.comment}
         *
         * @param reqDto
         * @return {@link ResponseDTO<EmptyBody>}
         * @throws BlinkException
         */
        @PostMapping("/save${entityOrigin}")
        public ResponseDTO<EmptyBody> save${entityOrigin}(@RequestBody @Validated RequestDTO<${addReqDTOName}> reqDto) throws BlinkException {
                ${entityLowerCase}Service.save${entityOrigin}(reqDto.getBody());
            return ResponseDTO.newSuccessInstance();
        }

        /**
         * 删除$!{table.comment}
         *
         * @param reqDto
         * @return {@link ResponseDTO<EmptyBody>}
         * @throws BlinkException
         */
        @PostMapping("/delete${entityOrigin}")
        public ResponseDTO<EmptyBody> delete${entityOrigin}(@RequestBody @Validated RequestDTO<${deleteReqDTOName}> reqDto) throws BlinkException {
                ${entityLowerCase}Service.delete${entityOrigin}(reqDto.getBody());
            return ResponseDTO.newSuccessInstance();
        }

        /**
         * 更新$!{table.comment}
         *
         * @param reqDto
         * @return {@link ResponseDTO<EmptyBody>}
         * @throws BlinkException
         */
        @PostMapping("/modify${entityOrigin}")
        public ResponseDTO<EmptyBody> modify${entityOrigin}(@RequestBody @Validated RequestDTO<${updateReqDTOName}> reqDto) throws BlinkException {
                ${entityLowerCase}Service.modify${entityOrigin}(reqDto.getBody());
            return ResponseDTO.newSuccessInstance();
        }

        /**
         * 根据查询条件查询$!{table.comment}列表
         *
         * @param reqDto
         * @return {@link ResponseDTO<EmptyBody>}
         * @throws BlinkException
         */
        @PostMapping("/get${entityOrigin}List")
        public ResponseDTO<${queryRspDTOName}> get${entityOrigin}List(@RequestBody @Validated RequestDTO<${queryReqDTOName}> reqDto) throws BlinkException {
            return ResponseDTO.newSuccessInstance(${entityLowerCase}Service.get${entityOrigin}List(reqDto.getBody()));
        }


}
